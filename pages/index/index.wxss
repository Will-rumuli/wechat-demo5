page {
  height: 100%;
  background: #f4f6f9;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

.scroll {
  flex: 1;
  height: 0;
  overflow: hidden;
}

.hero {
  padding: 36rpx 36rpx 26rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #16202e;
  letter-spacing: 1rpx;
}

.hero-desc {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #6b7a90;
  line-height: 1.6;
}

.hero-tags {
  margin-top: 22rpx;
  display: flex;
  flex-wrap: wrap;
}

.tag {
  margin-right: 14rpx;
  padding: 8rpx 20rpx;
  border-radius: 100rpx;
  font-size: 22rpx;
  color: #3f6fb5;
  background: rgba(47, 123, 255, 0.09);
}

.empty {
  padding: 40rpx 36rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-title {
  margin-top: 60rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #16202e;
}

.empty-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8595aa;
  text-align: center;
  line-height: 1.6;
}

.empty-actions {
  margin-top: 40rpx;
  width: 100%;
}

.action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  box-sizing: border-box;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.action.primary {
  color: #ffffff;
  background: linear-gradient(135deg, #2f7bff, #1c5bd8);
  box-shadow: 0 10rpx 24rpx rgba(31, 96, 226, 0.28);
}

.search {
  display: flex;
  align-items: center;
  margin: 0 30rpx 18rpx;
  padding: 0 24rpx;
  height: 76rpx;
  border-radius: 38rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(24, 48, 90, 0.05);
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #16202e;
}

.search-ph {
  color: #a3b1c4;
}

.search-clear {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #3f6fb5;
}

.no-result {
  padding: 70rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #a3b1c4;
}

.group-title {
  padding: 18rpx 6rpx 10rpx;
  font-size: 24rpx;
  color: #8595aa;
}

.docs {
  padding: 4rpx 30rpx 0;
}

.doc {
  display: flex;
  align-items: center;
  padding: 22rpx;
  margin-bottom: 18rpx;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(24, 48, 90, 0.06);
}

.doc-cover {
  flex-shrink: 0;
  width: 108rpx;
  height: 140rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #eef2f8;
}

.doc-cover-img {
  width: 100%;
  height: 100%;
  display: block;
}

.doc-cover.blank {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #a3b1c4;
  border: 2rpx dashed #d5dfec;
}

.doc-main {
  flex: 1;
  min-width: 0;
  padding: 0 20rpx;
  display: flex;
  flex-direction: column;
}

.doc-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #16202e;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.doc-meta {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: #8595aa;
}

.doc-more {
  flex-shrink: 0;
  width: 60rpx;
  height: 60rpx;
  line-height: 52rpx;
  text-align: center;
  color: #7b8ca3;
  font-size: 30rpx;
  letter-spacing: 2rpx;
}

.doc-add {
  padding: 30rpx 0;
  margin-bottom: 18rpx;
  text-align: center;
  font-size: 27rpx;
  color: #3f6fb5;
  border-radius: 22rpx;
  border: 2rpx dashed #c3d2e6;
  background: rgba(255, 255, 255, 0.7);
}

.tip {
  padding: 10rpx 0 30rpx;
  text-align: center;
}

.tip-text {
  font-size: 22rpx;
  color: #a3b1c4;
}

.safe-bottom {
  height: 30rpx;
}
