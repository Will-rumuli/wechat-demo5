page {
  height: 100%;
  overflow: hidden;
  background: #0d1117;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #0d1117;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 76rpx;
  padding: 0 30rpx;
  flex-shrink: 0;
}

.topbar-title {
  font-size: 24rpx;
  color: #9fb0c8;
  letter-spacing: 1rpx;
}

.topbar-count {
  font-size: 24rpx;
  color: #6f819b;
}

.stage {
  position: relative;
  flex: 1;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo {
  position: absolute;
  overflow: hidden;
  border-radius: 4rpx;
}

.photo-img {
  width: 100%;
  height: 100%;
  display: block;
}

/* 框内命中区：用于点选与长按整体拖动，保持透明不影响视觉 */
.box-hit {
  position: absolute;
  background: rgba(47, 123, 255, 0);
}

.box-hit-on {
  background: rgba(47, 123, 255, 0.05);
}

.seg {
  position: absolute;
  height: 3rpx;
  background: rgba(255, 255, 255, 0.55);
  transform-origin: 0 50%;
  pointer-events: none;
  border-radius: 3rpx;
}

.seg-on {
  background: #4c9aff;
  box-shadow: 0 0 12rpx rgba(76, 154, 255, 0.75);
}

.handle {
  position: absolute;
  width: 88rpx;
  height: 88rpx;
  margin-left: -44rpx;
  margin-top: -44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dot {
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  border: 4rpx solid rgba(41, 52, 70, 0.9);
  box-sizing: border-box;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.55);
}

.dot-on {
  background: #ffffff;
  border-color: #2f7bff;
  width: 34rpx;
  height: 34rpx;
}

.box-del {
  position: absolute;
  width: 54rpx;
  height: 54rpx;
  margin-left: -27rpx;
  margin-top: -27rpx;
  border-radius: 50%;
  background: #e5484d;
  border: 2rpx solid rgba(255, 255, 255, 0.85);
  box-sizing: border-box;
  color: #ffffff;
  font-size: 34rpx;
  line-height: 48rpx;
  text-align: center;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.5);
}

.preview-list {
  width: 100%;
  height: 100%;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.preview-item {
  position: relative;
  margin-bottom: 24rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.45);
}

.preview-img {
  width: 100%;
  display: block;
}

.preview-no {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  z-index: 2;
  padding: 4rpx 18rpx;
  border-radius: 20rpx;
  background: rgba(15, 26, 42, 0.66);
  color: #ffffff;
  font-size: 22rpx;
}

.panel {
  flex-shrink: 0;
  padding: 26rpx 28rpx calc(26rpx + env(safe-area-inset-bottom));
  background: #161c26;
  border-top: 1rpx solid #232c3a;
}

.chips {
  white-space: nowrap;
  width: 100%;
}

.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 32rpx;
  margin-right: 16rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #a8b7cc;
  background: #222b38;
  border: 1rpx solid transparent;
}

.chip-on {
  color: #8cbcff;
  background: rgba(47, 123, 255, 0.16);
  border-color: #2f7bff;
}

.actions {
  display: flex;
  align-items: center;
  margin-top: 26rpx;
}

.actions .btn {
  flex: 1;
  height: 84rpx;
  font-size: 30rpx;
  min-width: 0;
}

.actions .btn.ghost {
  flex: 0 0 200rpx;
  width: 200rpx;
  padding: 0;
  margin-right: 16rpx;
  background: transparent;
  border: 1rpx solid #333f52;
  color: #b9c7db;
}

.actions .btn.ghost.small {
  flex: 0 0 112rpx;
  width: 112rpx;
  height: 84rpx;
  font-size: 26rpx;
  padding: 0;
  margin-right: 12rpx;
}

.work {
  position: absolute;
  left: 0;
  top: 0;
  width: 100px;
  height: 100px;
  opacity: 0;
  overflow: hidden;
  pointer-events: none;
}
