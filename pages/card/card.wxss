page {
  height: 100%;
  background: #f4f6f9;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

.scroll {
  flex: 1;
  height: 0;
  overflow: hidden;
}

.hint {
  padding: 28rpx 32rpx 6rpx;
  font-size: 24rpx;
  color: #8595aa;
  line-height: 1.6;
}

.types {
  display: flex;
  flex-wrap: wrap;
  padding: 18rpx 32rpx 6rpx;
}

.chip {
  margin-right: 16rpx;
  margin-bottom: 12rpx;
  padding: 12rpx 28rpx;
  border-radius: 100rpx;
  font-size: 26rpx;
  color: #4a5a70;
  background: #ffffff;
  border: 2rpx solid #e2e8f2;
  box-sizing: border-box;
}

.chip.chip-on {
  color: #1c5bd8;
  background: rgba(47, 123, 255, 0.12);
  border-color: #2f7bff;
  font-weight: 600;
}

.slots {
  padding: 16rpx 32rpx 0;
}

.slot {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 400rpx;
  margin-bottom: 26rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(24, 48, 90, 0.07);
}

.slot.empty {
  border: 2rpx dashed #c3d2e6;
  box-shadow: none;
}

.slot-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: #f4f7fb;
  display: block;
}

.slot-plus {
  font-size: 64rpx;
  color: #9db4d3;
  line-height: 1;
}

.slot-hint {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8595aa;
}

.slot-label {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 20rpx;
  font-size: 22rpx;
  color: #ffffff;
  background: linear-gradient(180deg, rgba(15, 26, 42, 0), rgba(15, 26, 42, 0.62));
}

.slot.empty .slot-label {
  color: #7b8ca3;
  background: none;
  text-align: center;
}

.note {
  padding: 10rpx 32rpx 0;
  font-size: 22rpx;
  color: #a3b1c4;
  line-height: 1.7;
}

.safe-bottom {
  height: 30rpx;
}

.bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 30rpx calc(22rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid #e8edf5;
}

.bar-count {
  font-size: 26rpx;
  color: #8595aa;
}

.bar .btn {
  height: 76rpx;
  padding: 0 40rpx;
  font-size: 28rpx;
}

.btn.disabled {
  opacity: 0.45;
}

.cv {
  position: absolute;
  left: 0;
  top: 0;
  width: 100px;
  height: 100px;
  opacity: 0;
  pointer-events: none;
}

.adj {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  flex-direction: column;
  background: #0b1018;
}

.adj-head {
  flex-shrink: 0;
  padding: 28rpx 32rpx 10rpx;
  font-size: 24rpx;
  color: #9db0c8;
  text-align: center;
}

.adj-stage {
  position: relative;
  flex: 1;
  height: 0;
  overflow: hidden;
}

.adj-img {
  position: absolute;
  display: block;
  background: #11161f;
}

.adj-line {
  position: absolute;
  height: 2px;
  margin-top: -1px;
  background: #4da3ff;
  transform-origin: 0 50%;
  border-radius: 2px;
  pointer-events: none;
}

.adj-dot {
  position: absolute;
  z-index: 2;
  width: 40rpx;
  height: 40rpx;
  margin-left: -20rpx;
  margin-top: -20rpx;
  box-sizing: border-box;
  border-radius: 50%;
  background: #ffffff;
  border: 4rpx solid #2f7bff;
  box-shadow: 0 0 0 8rpx rgba(47, 123, 255, 0.22);
}

.adj-foot {
  flex-shrink: 0;
  display: flex;
  padding: 22rpx 26rpx calc(22rpx + env(safe-area-inset-bottom));
  background: #0b1018;
}

.adj-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  margin: 0 8rpx;
  border-radius: 14rpx;
  font-size: 28rpx;
  text-align: center;
  color: #d7e2f0;
  background: rgba(255, 255, 255, 0.08);
}

.adj-btn.main {
  color: #ffffff;
  background: #2f7bff;
  font-weight: 600;
}
